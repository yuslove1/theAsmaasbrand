# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Resend (email)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL="The Asmaa's Brand <orders@yourdomain.com>"
ADMIN_EMAIL=asmaurufai37@gmail.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Cron (protects /api/cron/* routes from public calls)
CRON_SECRET=choose_a_strong_secret_key_here

# Admin login (gates /admin pages)
ADMIN_LOGIN_EMAIL=you@example.com
# Generate with: node -e "const b=require('bcryptjs'); console.log(Buffer.from(b.hashSync('your_password', 12)).toString('base64'))"
# (base64-encoded so the bcrypt hash's $ characters can't be misread as shell/dotenv variable expansion)
ADMIN_LOGIN_PASSWORD_HASH_B64=paste_base64_value_here
ADMIN_SESSION_SECRET=run_openssl_rand_hex_32_and_paste_here
